MONAD_MAINNET_RPC=https://rpc.monad.xyz
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
PRIVATE_KEY=

# Core deployment / configuration
ADAPTER_REGISTRY=
KURU_ADAPTER=
PERPL_ADAPTER=
EULER_ADAPTER=
WALLET_BALANCE_ADAPTER=

# Kuru integration. CSV values are consumed by Foundry deployment/config scripts.
KURU_MARGIN_ACCOUNT=
KURU_TRACKED_TOKENS=
KURU_MARKETS=

# Perpl integration
PERPL_EXCHANGE=
PERPL_COLLATERAL=
PERPL_TRACKED_PERP_IDS=

# Euler integration
EULER_EVC=
EULER_TRACKED_VAULTS=

# Assets held directly by the CL Account that must remain visible to the risk engine.
FREE_COLLATERAL_ASSETS=

# RiskRegistry configuration for the primary Metropolis underlying + collateral pair.
# Feed addresses must be Chainlink-compatible and re-verified on the selected Monad network.
RISK_REGISTRY=
RISK_UNDERLYING_ASSET=
RISK_UNDERLYING_FEED=
RISK_UNDERLYING_DECIMALS=18
RISK_UNDERLYING_INITIAL_MARGIN_BPS=2000
RISK_UNDERLYING_MAINTENANCE_MARGIN_BPS=1200
RISK_UNDERLYING_HEDGE_MARGIN_BPS=300
RISK_UNDERLYING_STRESS_BPS=2000
RISK_UNDERLYING_MAX_STALENESS=3600
RISK_COLLATERAL_ASSET=
RISK_COLLATERAL_FEED=
RISK_COLLATERAL_DECIMALS=6
RISK_COLLATERAL_INITIAL_MARGIN_BPS=100
RISK_COLLATERAL_MAINTENANCE_MARGIN_BPS=50
RISK_COLLATERAL_HEDGE_MARGIN_BPS=50
RISK_COLLATERAL_STRESS_BPS=300
RISK_COLLATERAL_MAX_STALENESS=3600
# Perpl unit configuration is protocol-specific and must be verified before broadcast.
RISK_PERPL_EXPOSURE_DECIMALS=0
RISK_PERPL_COLLATERAL_DECIMALS=0
RISK_PERPL_PNL_DECIMALS=0

# Public Risk API
CL_CHAIN_ID=10143
CL_RPC_URL=https://testnet-rpc.monad.xyz
CL_ACCOUNT_FACTORY=
CL_ADAPTER_REGISTRY=
CL_RISK_REGISTRY=
CL_RISK_ENGINE=
CL_RISK_POLICY_MANAGER=
CL_RISK_SOLVER=
CL_INTENT_ENGINE=
CL_CAPITAL_ROUTER=
CL_MULTI_STEP_PLANNER=
CL_DEFENSIVE_EXECUTOR=
CL_KEEPER_NETWORK=
CL_SIMULATION_ENGINE=
PORT=8787

# CL Terminal (Vite exposes only VITE_* values to the browser; never put PRIVATE_KEY here)
VITE_CL_CHAIN_ID=10143
VITE_CL_RPC_URL=https://testnet-rpc.monad.xyz
VITE_CL_ACCOUNT_FACTORY=
VITE_CL_ADAPTER_REGISTRY=
VITE_CL_RISK_REGISTRY=
VITE_CL_RISK_ENGINE=
VITE_CL_RISK_POLICY_MANAGER=
VITE_CL_RISK_SOLVER=
VITE_CL_INTENT_ENGINE=
VITE_CL_CAPITAL_ROUTER=
VITE_CL_MULTI_STEP_PLANNER=
VITE_CL_DEFENSIVE_EXECUTOR=
VITE_CL_KEEPER_NETWORK=
VITE_CL_SIMULATION_ENGINE=
VITE_CL_KURU_ADAPTER=
VITE_CL_PERPL_ADAPTER=
VITE_CL_EULER_ADAPTER=
VITE_CL_WALLET_BALANCE_ADAPTER=
